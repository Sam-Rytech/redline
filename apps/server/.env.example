# Every variable apps/server reads. Copy to .env for local use; set them in the host's
# environment in production. No real secrets in this file.

# production turns on the strict checks (SESSION_SECRET required)
NODE_ENV=development

# HTTP port
PORT=8787

# SQLite file (docs/DATABASE.md). On the host, point it at the persistent volume.
DATABASE_PATH=./data/redline.db

# At least 32 characters. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Nightly database backups go here (kept 7 days). Leave empty to turn backups off.
BACKUP_DIR=

# Preferred Fulcrum (Electrum) server, tried first; five public fallbacks follow it. Empty = fallbacks only.
ELECTRUM_HOST=

# Chain refresh interval and timeout, in milliseconds
REFRESH_MS=60000
REFRESH_TIMEOUT_MS=30000

# Domain the wallet signs into the login transaction: the web app's host, no scheme
LOGIN_DOMAIN=localhost

# The only Origin allowed on POST, PATCH and DELETE (CSRF rule in docs/SECURITY.md).
# Required in production. Local default http://localhost:5173 (the web app);
# use http://localhost:5174 when testing with apps/login-demo.
PUBLIC_ORIGIN=

# Proxies in front of the server that append to x-forwarded-for (0 = use the TCP peer).
# Find the right number with LOG_XFF=1 on staging; see docs/SECURITY.md.
TRUST_PROXY_HOPS=0

# 1 = log the raw x-forwarded-for of the first 5 /api/auth requests, then stop
LOG_XFF=

# Telegram bot token from @BotFather (send it /newbot). Linking and alerts are off when empty.
# Only one running server may use a token: leave it empty on your laptop while the host has it.
TELEGRAM_BOT_TOKEN=

# Where Pro pass payments go: a mainnet bitcoincash: address you control (token-aware z... preferred).
# Receive-only; the server never has its key. Payments are off when empty.
MERCHANT_ADDRESS=
