# Redline server environment. Copy to .env for local use; on Railway set these in the service Variables tab.
# Never commit real values.

# Port to listen on (Railway sets this itself; leave it unset there).
PORT=8787

# SQLite file. Local default ./data/redline.db. On Railway mount a Volume at /data and use:
DB_PATH=./data/redline.db
# DB_PATH=/data/redline.db

# Domain bound into the sign-in OP_RETURN: the host of the site users sign in on (no scheme). Default localhost.
LOGIN_DOMAIN=localhost

# Exact origin of the web app, e.g. https://redline.vercel.app. When set, every POST must carry this Origin (CSRF guard)
# and Telegram links point to it. Leave unset for local dev.
PUBLIC_ORIGIN=

# Cookies get the Secure flag unless this is "false". Keep true in production (browsers accept it on http://localhost too).
COOKIE_SECURE=true

# Number of trusted proxy hops in front of the server (0 = use the socket address). Measure on staging with LOG_XFF=1.
TRUST_PROXY_HOPS=0

# 1 = log the raw x-forwarded-for of the first 5 /api/auth requests, to work out TRUST_PROXY_HOPS. Unset afterwards.
LOG_XFF=

# Preferred Fulcrum/Electrum host (public fallbacks are always tried after it). Optional.
ELECTRUM_HOST=

# How often the chain reader refreshes loans and price, in ms (min 5000, default 60000).
REFRESH_MS=60000

# Timeout for one refresh, in ms (default 30000).
REFRESH_TIMEOUT_MS=30000

# Bot token from @BotFather. The Telegram bot and alerts run only when set. Only ONE running server may use a token.
TELEGRAM_BOT_TOKEN=

# Bot username without @ (optional; otherwise asked from Telegram at startup).
BOT_USERNAME=

# Where Pro pass payments go: a mainnet bitcoincash: address (token-aware bitcoincash:z... preferred). Receive-only; no key
# is ever on the server. Unset = payments off (invoice routes answer 503).
MERCHANT_ADDRESS=
